generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("POSTGRES_URL")
}

enum SeverityLevel {
  LOW
  MEDIUM
  HIGH
}

model Log {
  id        Int           @id @default(autoincrement())
  message   String
  origin    String
  published Boolean       @default(false)
  level     SeverityLevel
  createdAt DateTime      @default(now())
}
